@page
@model DigitalBanking.Dashboard.Pages.LoginModel
@{
    ViewData["Title"] = "Giriş";
}

<div class="auth-login">
    <div class="auth-login-content">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="eyebrow mb-2">DigitalBanking</div>
                <h1 class="h3 mb-3">Giriş</h1>

                @if (!string.IsNullOrEmpty(Model.Info))
                {
                    <div class="alert alert-info">@Model.Info</div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" for="Username">Kullanıcı adı</label>
                        <input class="form-control" asp-for="Username" autocomplete="username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Password">Şifre</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Giriş yap</button>
                </form>

                <div class="d-flex flex-wrap gap-2 justify-content-between mt-3 small">
                    <a href="/Register">Üye ol</a>
                    <span class="text-muted">Şifrenizi kimseyle paylaşmayın.</span>
                </div>
                <div class="form-text mt-2">Yeni üyelikler Owner aktivasyonundan sonra giriş yapabilir.</div>
            </div>
        </div>
    </div>
</div>
