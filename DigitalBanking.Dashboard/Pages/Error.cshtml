@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="alert alert-danger">
    <h4 class="alert-heading">İşlem tamamlanamadı</h4>
    <p class="mb-0">
        Beklenmeyen bir hata oluştu. Teknik ayrıntılar kullanıcıya gösterilmez.
        Lütfen tekrar deneyin; sorun sürerse yerel demo servislerinin çalıştığını kontrol edin.
    </p>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Destek için istek numarası: <code>@Model.RequestId</code></p>
}

<a class="btn btn-outline-primary" href="/">Panele dön</a>
