@page
@model DigitalBanking.Dashboard.Pages.Customer.Accounts.DetailsModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Hesap Hareketleri";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Account is not null)
{
    if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="alert alert-info">@Model.Flash</div>
    }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="text-muted small">@DashboardUi.Account(Model.Account.AccountNumber)</div>
            <h3 class="mb-0">@Model.Account.AccountName</h3>
            <div class="text-muted">@DashboardUi.Status(Model.Account.AccountType) · @Model.Account.Currency hesabı</div>
            <div class="h4 mt-2">@DashboardUi.Money(Model.Account.Balance, Model.Account.Currency)</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="/Customer/Transfer?from=@Model.Account.Id">Transfer talebi</a>
            <a class="btn btn-outline-primary" href="/Customer/Requests?type=Deposit&accountId=@Model.Account.Id">Para Yatır</a>
            <a class="btn btn-outline-primary" href="/Customer/Requests?type=Withdrawal&accountId=@Model.Account.Id">Para Çek</a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Hesap adını düzenle</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Rename" class="row g-2">
                <input type="hidden" name="id" value="@Model.Account.Id" />
                <div class="col-md-8">
                    <label class="form-label" for="accountName">Hesap adı</label>
                    <input class="form-control" id="accountName" name="accountName" value="@Model.Account.AccountName" maxlength="100" required />
                </div>
                <div class="col-md-4 align-self-end">
                    <button class="btn btn-outline-primary" type="submit">Adı güncelle</button>
                </div>
            </form>
            <div class="form-text mt-2">Hesap adını yalnız hesabın sahibi değiştirebilir. Boşluklar kırpılır; 100 karakter sınırı vardır.</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">İşlem geçmişi</div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-dark"><tr><th>Tarih</th><th>Tür</th><th class="text-end">Tutar</th><th class="text-end">Bakiye</th><th>Açıklama</th></tr></thead>
                <tbody>
                @if (Model.History is null || Model.History.Transactions.Count == 0)
                {
                    <tr><td colspan="5"><div class="empty-state">Bu hesapta henüz hareket yok. Para Yatır talebiyle başlayabilirsiniz.</div></td></tr>
                }
                else
                {
                @foreach (var t in Model.History.Transactions)
                {
                    <tr>
                        <td>@DashboardUi.Date(t.CreatedDate)</td>
                        <td>@DashboardUi.TransactionType(t.Type)</td>
                        <td class="text-end">@DashboardUi.Money(t.Amount, Model.Account.Currency)</td>
                        <td class="text-end">@DashboardUi.Money(t.BalanceAfter, Model.Account.Currency)</td>
                        <td>@t.Description</td>
                    </tr>
                }
                }
                </tbody>
            </table>
        </div>
    </div>
}
