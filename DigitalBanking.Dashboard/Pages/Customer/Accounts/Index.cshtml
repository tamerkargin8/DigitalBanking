@page
@model DigitalBanking.Dashboard.Pages.Customer.Accounts.IndexModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Hesaplarım";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h3 class="mb-1">Hesaplarım</h3>
        <div class="text-muted small">Vadesiz, Vadeli ve Yatırım hesaplarınızı ayrı sekmelerde yönetin.</div>
    </div>
    <a class="btn btn-primary" href="/Customer/Requests?type=AccountOpening">Hesap Aç</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<ul class="nav nav-tabs mb-3">
    @foreach (var tab in Model.Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.SelectedType == tab.Key ? "active" : "")"
               href="/Customer/Accounts?type=@tab.Key">@tab.Label <span class="badge bg-secondary ms-1">@tab.Count</span></a>
        </li>
    }
</ul>

@if (Model.FilteredAccounts.Count == 0)
{
    <div class="card"><div class="empty-state">
        <h5>@(Model.SelectedType == "All" ? "Henüz hesabınız yok" : $"{Model.Tabs.First(x => x.Key == Model.SelectedType).Label} hesabınız yok")</h5>
        <p class="mb-3">İlk hesabınızı açmak için tür, hesap adı ve para birimi seçin; Owner/yetkili onayından sonra hesap listelenir.</p>
        <a class="btn btn-primary" href="/Customer/Requests?type=AccountOpening&accountType=@(Model.SelectedType == "All" ? "Checking" : Model.SelectedType)">Hesap Aç</a>
    </div></div>
}
else
{
    <div class="row g-4">
        @foreach (var a in Model.FilteredAccounts)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="text-muted small">@DashboardUi.Status(a.AccountType) · @a.Currency</div>
                                <h4 class="mb-1">@a.AccountName</h4>
                            </div>
                            <span class="badge bg-secondary">@DashboardUi.Status(a.AccountType)</span>
                        </div>
                        <div class="h4 mt-3">@DashboardUi.Money(a.Balance, a.Currency)</div>
                        <div class="text-muted">@DashboardUi.Account(a.AccountNumber)</div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a class="btn btn-outline-primary btn-sm" href="/Customer/Accounts/Details?id=@a.Id">Hesap detayı</a>
                            <a class="btn btn-outline-primary btn-sm" href="/Customer/Requests?type=Deposit&accountId=@a.Id">Para Yatır</a>
                            <a class="btn btn-outline-primary btn-sm" href="/Customer/Requests?type=Withdrawal&accountId=@a.Id">Para Çek</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="alert alert-info mt-4 mb-0">
    Vadeli ve Yatırım hesapları bu demo sürümünde yalnız hesap türü/yönetim demosudur;
    faiz, tahakkuk, alım-satım veya kur getirisi hesaplanmaz.
</div>
