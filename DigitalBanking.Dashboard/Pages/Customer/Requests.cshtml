@page
@model DigitalBanking.Dashboard.Pages.Customer.RequestsModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Finansal Talep";
}

<h3 class="mb-1">Yatırma / Çekme / Hesap Açılışı Talebi</h3>
<p class="text-muted">Tüm talepler Pending başlar; onaylanana kadar bakiye değişmez. Yatırma/çekme demo teller işlemidir; müşteri kendi kendine para yaratamaz.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card form-card">
    <div class="card-body">
        <form method="post" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Talep türü</label>
                <select class="form-select" asp-for="RequestType">
                    @foreach (var t in new[] { "Deposit", "Withdrawal", "AccountOpening" })
                    {
                        <option value="@t" selected="@(Model.RequestType == t)">@DashboardUi.Status(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Hesap (yatırma/çekme)</label>
                <select class="form-select" asp-for="AccountId">
                    <option value="">Seçin</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Id">@DashboardUi.Account(a.AccountNumber) · @a.Currency · @DashboardUi.Money(a.Balance, a.Currency)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Para birimi (açılış)</label>
                <select class="form-select" asp-for="Currency">
                    @foreach (var c in new[] { "TRY", "USD", "EUR", "GBP" })
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tutar</label>
                <input class="form-control" asp-for="Amount" type="number" step="0.01" min="0" />
            </div>
            <div class="col-12">
                <label class="form-label">Açıklama</label>
                <input class="form-control" asp-for="Description" maxlength="250" />
            </div>
            <input type="hidden" asp-for="IdempotencyKey" />
            <div class="col-12">
                <button class="btn btn-primary" type="submit">Talebi gönder</button>
            </div>
        </form>
        <div class="form-text mt-2">Hesap açılışında müşteri profiliniz ve seçtiğiniz para birimi kullanılır; Owner onayı sonrası hesap oluşur.</div>
    </div>
</div>
