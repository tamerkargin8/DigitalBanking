@page
@model DigitalBanking.Dashboard.Pages.Customer.RequestsModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Finansal Talep";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">İşlemler</div>
        <h2>Finansal Talep</h2>
        <p>Tüm talepler onay bekleyerek başlar; onaylanana kadar bakiye değişmez. Yatırma ve çekme demo teller işlemidir.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/Customer/Payments">Taleplerim</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Accounts.Count == 0)
{
    <div class="alert alert-info">
        Henüz hesabınız yok. <strong>Hesap açılışı</strong> talebi oluşturun; Owner onayından sonra hesap açılır.
        Yatırma/çekme için önce bir hesabınızın olması gerekir.
    </div>
}

<div class="card form-card">
    <div class="card-body">
        @if (Model.ShowSummary)
        {
            <h5 class="mb-3">Talebi kontrol edin</h5>
            <div class="summary-box mb-3">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Talep</dt><dd class="col-sm-8">@DashboardUi.Status(Model.RequestType)</dd>
                    @if (Model.RequestType == "AccountOpening")
                    {
                        <dt class="col-sm-4">Hesap</dt><dd class="col-sm-8">@Model.AccountName · @DashboardUi.Status(Model.AccountType) · @Model.Currency</dd>
                    }
                    else
                    {
                        var selected = Model.Accounts.FirstOrDefault(x => x.Id == Model.AccountId);
                        <dt class="col-sm-4">Hesap</dt><dd class="col-sm-8">@(selected?.AccountName ?? "—") · @DashboardUi.Account(selected?.AccountNumber) · @selected?.Currency</dd>
                    }
                    <dt class="col-sm-4">Tutar</dt><dd class="col-sm-8">@DashboardUi.Money(Model.Amount, Model.RequestType == "AccountOpening" ? Model.Currency : (Model.Accounts.FirstOrDefault(x => x.Id == Model.AccountId)?.Currency ?? ""))</dd>
                    <dt class="col-sm-4">Açıklama</dt><dd class="col-sm-8">@(Model.Description ?? "—")</dd>
                    <dt class="col-sm-4">Onay</dt><dd class="col-sm-8">Talep Pending başlar; bakiye yalnız yetkili onayında değişir.</dd>
                </dl>
            </div>
            <form method="post">
                <input type="hidden" asp-for="RequestType" />
                <input type="hidden" asp-for="AccountId" />
                <input type="hidden" asp-for="AccountName" />
                <input type="hidden" asp-for="AccountType" />
                <input type="hidden" asp-for="Currency" />
                <input type="hidden" asp-for="Amount" />
                <input type="hidden" asp-for="Description" />
                <input type="hidden" asp-for="IdempotencyKey" />
                <input type="hidden" name="Confirm" value="true" />
                <button class="btn btn-primary" type="submit">Talebi gönder</button>
            </form>
            <form method="post" class="mt-2">
                <input type="hidden" asp-for="RequestType" />
                <input type="hidden" asp-for="AccountId" />
                <input type="hidden" asp-for="AccountName" />
                <input type="hidden" asp-for="AccountType" />
                <input type="hidden" asp-for="Currency" />
                <input type="hidden" asp-for="Amount" />
                <input type="hidden" asp-for="Description" />
                <input type="hidden" asp-for="IdempotencyKey" />
                <input type="hidden" name="Confirm" value="false" />
                <input type="hidden" name="Edit" value="true" />
                <button class="btn btn-outline-secondary" type="submit">Düzenle</button>
            </form>
        }
        else
        {
        <form method="post" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="RequestType">Talep türü</label>
                <select class="form-select" asp-for="RequestType" id="RequestType">
                    @foreach (var t in new[] { "Deposit", "Withdrawal", "AccountOpening" })
                    {
                        <option value="@t" selected="@(Model.RequestType == t)">@DashboardUi.Status(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="AccountId">Hesap (yatırma/çekme; açılışta boş)</label>
                <select class="form-select" asp-for="AccountId">
                    <option value="">Seçin</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Id">@DashboardUi.Account(a.AccountNumber) · @a.Currency · @DashboardUi.Money(a.Balance, a.Currency)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="AccountType">Hesap türü (açılış)</label>
                <select class="form-select" asp-for="AccountType">
                    @foreach (var t in new[] { "Checking", "TimeDeposit", "Investment" })
                    {
                        <option value="@t">@DashboardUi.Status(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="AccountName">Hesap adı (açılış)</label>
                <input class="form-control" asp-for="AccountName" maxlength="100" placeholder="Örn. Birikim Hesabım" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Currency">Para birimi (açılış)</label>
                <select class="form-select" asp-for="Currency">
                    @foreach (var c in new[] { "TRY", "USD", "EUR", "GBP" })
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Amount">Tutar / açılış bakiyesi</label>
                <input class="form-control" asp-for="Amount" type="number" step="0.01" min="0" />
            </div>
            <div class="col-12">
                <label class="form-label" for="Description">Açıklama</label>
                <input class="form-control" asp-for="Description" maxlength="250" />
            </div>
            <input type="hidden" asp-for="IdempotencyKey" />
            <input type="hidden" name="Confirm" value="false" />
            <div class="col-12">
                <button class="btn btn-primary" type="submit">Özete geç</button>
            </div>
        </form>
        }
        <div class="form-text mt-2">Hesap açılışında hesap seçimi gerekmez; tür, ad ve para birimi kullanılır. Vadeli/Yatırım yalnız ürün/yönetim demosudur; faiz, tahakkuk veya alım-satım hesaplanmaz. Yatırma/çekme talepleri de onay bekler.</div>
    </div>
</div>
