@page
@model DigitalBanking.Dashboard.Pages.Customer.Payments.IndexModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Ödemelerim";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">İşlemler</div>
        <h2>Ödemelerim</h2>
        <p>Oluşturduğunuz transfer ve para taleplerinin durumunu ve onay geçmişini görüntüleyin.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-primary" href="/Customer/Transfer"><svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg>Transfer talebi</a>
        <a class="btn btn-outline-primary" href="/Customer/Requests">Yatırma/Çekme talebi</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark"><tr><th>Referans</th><th>Tür</th><th class="text-end">Tutar</th><th>Risk</th><th>Durum</th><th>Tarih</th><th></th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state">Henüz ödeme veya talep yok. Transfer ya da hesap açılışı talebi oluşturarak başlayın.</div></td></tr>
            }
            else
            {
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><a href="/Customer/Payments/Details?id=@p.Id">@p.Reference</a></td>
                    <td>@DashboardUi.Status(p.RequestType)</td>
                    <td class="text-end">@DashboardUi.Money(p.Amount, p.Currency)</td>
                    <td><span class="@DashboardUi.RiskBadgeClass(p.RiskLevel)">@DashboardUi.Status(p.RiskLevel)</span></td>
                    <td><span class="@DashboardUi.StatusBadgeClass(p.Status)">@DashboardUi.Status(p.Status)</span></td>
                    <td>@DashboardUi.Date(p.CreatedAt)</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Customer/Payments/Details?id=@p.Id">Aç</a></td>
                </tr>
            }
            }
            </tbody>
        </table>
    </div>
</div>
