@page
@model DigitalBanking.Dashboard.Pages.Customer.HomeModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Hesap Özeti";
    var pendingCount = Model.Payments.Count(x => x.Status == "Pending");
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@if (Model.Profile is not null)
{
    <section class="welcome-panel" aria-labelledby="welcome-title">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="eyebrow">Dijital bankacılık</div>
                <h2 id="welcome-title">Merhaba, @Model.Profile.DisplayName</h2>
                <p>Hesaplarınızı, taleplerinizi ve yaklaşan işlemlerinizi tek yerden yönetin. Tüm finansal talepler yetkili onayına kadar bekler.</p>
                <div class="welcome-actions">
                    <a class="btn btn-light" href="/Customer/Transfer"><svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg>Transfer talebi</a>
                    <a class="btn btn-outline-light" href="/Customer/Requests?type=AccountOpening"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Hesap açılışı</a>
                </div>
            </div>
            <div class="welcome-meta">
                <span class="pending-chip"><span class="dot"></span>@pendingCount bekleyen talep</span>
                <span class="small text-white-50">Müşteri no: @Model.Profile.CustomerId.ToString("N")[..8]</span>
            </div>
        </div>
    </section>

    @if (Model.Accounts.Count == 0)
    {
        <section class="card mb-4" aria-labelledby="first-account-title">
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true"><svg class="icon"><use href="#i-wallet"></use></svg></div>
                <h3 id="first-account-title">İlk hesabınızı açın</h3>
                <p>Hesap açılışı talebi oluşturun. Kurucu yönetici veya yetkili onaylayana kadar hesap ve bakiye oluşmaz.</p>
                <a class="btn btn-primary" href="/Customer/Requests?type=AccountOpening">Hesap açılışı talebi oluştur</a>
            </div>
        </section>
    }
    else
    {
        <div class="section-heading">
            <div>
                <h2>Bakiyeler</h2>
                <div class="small">Para birimleri ayrı gösterilir; kur çevrimi veya toplama yapılmaz.</div>
            </div>
        </div>
        <div class="balance-grid mb-4">
            @foreach (var group in Model.AccountsByCurrency)
            {
                <div class="balance-card">
                    <div class="ccy">@group.Key</div>
                    <div class="amount">@DashboardUi.Money(group.Sum(x => x.Balance), group.Key)</div>
                    <div class="acct">@group.Count() hesap · toplam</div>
                </div>
            }
        </div>

        <div class="section-heading">
            <div>
                <h2>Hesaplarım</h2>
                <div class="small">Hesap adını ve ürününü hesap detayından yönetebilirsiniz.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary" href="/Customer/Accounts">Tüm hesaplar</a>
        </div>
        <div class="account-grid mb-4">
            @foreach (var a in Model.Accounts)
            {
                <a class="account-card" href="/Customer/Accounts/Details?id=@a.Id">
                    <div class="account-card-top">
                        <span class="product-tag">@DashboardUi.Status(a.AccountType)</span>
                        <span class="currency-tag">@a.Currency</span>
                    </div>
                    <h3>@a.AccountName</h3>
                    <div class="account-number">@DashboardUi.Account(a.AccountNumber)</div>
                    <div class="account-balance">@DashboardUi.Money(a.Balance, a.Currency)</div>
                    <span class="account-link">Hesap detayı <span aria-hidden="true">→</span></span>
                </a>
            }
        </div>
    }

    @if (Model.Accounts.Count > 0)
    {
        <div class="quick-actions" aria-label="Hızlı işlemler">
            <a class="quick-action" href="/Customer/Transfer">
                <span class="icon-wrap" aria-hidden="true"><svg class="icon"><use href="#i-send"></use></svg></span>
                <span><strong>Transfer</strong><small>Alıcıya talep oluştur</small></span>
            </a>
            <a class="quick-action" href="/Customer/Requests?type=Deposit">
                <span class="icon-wrap" aria-hidden="true"><svg class="icon"><use href="#i-arrow-down"></use></svg></span>
                <span><strong>Para yatır</strong><small>Onaylı yatırma talebi</small></span>
            </a>
            <a class="quick-action" href="/Customer/Requests?type=Withdrawal">
                <span class="icon-wrap" aria-hidden="true"><svg class="icon"><use href="#i-arrow-up"></use></svg></span>
                <span><strong>Para çek</strong><small>Onaylı çekme talebi</small></span>
            </a>
            <a class="quick-action" href="/Customer/Requests?type=AccountOpening">
                <span class="icon-wrap" aria-hidden="true"><svg class="icon"><use href="#i-plus"></use></svg></span>
                <span><strong>Hesap aç</strong><small>Vadesiz, vadeli veya yatırım</small></span>
            </a>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-header">
                    <span>Son talepler</span>
                    <a class="btn btn-sm btn-outline-secondary ms-auto" href="/Customer/Payments">Tümünü gör</a>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Referans</th><th>Talep</th><th class="text-end">Tutar</th><th>Durum</th><th>Tarih</th></tr></thead>
                        <tbody>
                        @if (Model.Payments.Count == 0)
                        {
                            <tr><td colspan="5"><div class="empty-state py-4">Henüz talebiniz yok. Transfer veya hesap açılışı talebi oluşturabilirsiniz.</div></td></tr>
                        }
                        else
                        {
                            @foreach (var p in Model.Payments.Take(6))
                            {
                                <tr>
                                    <td><a href="/Customer/Payments/Details?id=@p.Id">@p.Reference</a></td>
                                    <td>@DashboardUi.Status(p.RequestType)</td>
                                    <td class="text-end">@DashboardUi.Money(p.Amount, p.Currency)</td>
                                    <td><span class="@DashboardUi.StatusBadgeClass(p.Status)">@DashboardUi.Status(p.Status)</span></td>
                                    <td class="text-muted">@DashboardUi.Date(p.CreatedAt)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header">Demo hesap özeti</div>
                <div class="card-body">
                    <div class="soft-panel mb-3">
                        <div class="fw-semibold mb-1">Talepler her zaman onaya tabidir</div>
                        <div class="small">Transfer, yatırma, çekme ve hesap açılışı; yetkili onayına kadar beklemede kalır. Bu demo gerçek banka bağlantısı kullanmaz.</div>
                    </div>
                    <dl class="row mb-0 small">
                        <dt class="col-6 text-muted fw-normal">Aktif hesap</dt><dd class="col-6 text-end fw-semibold">@Model.Accounts.Count</dd>
                        <dt class="col-6 text-muted fw-normal">Bekleyen talep</dt><dd class="col-6 text-end fw-semibold">@pendingCount</dd>
                        <dt class="col-6 text-muted fw-normal">Rol</dt><dd class="col-6 text-end fw-semibold">@DashboardUi.Status(Model.Profile.Role)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
