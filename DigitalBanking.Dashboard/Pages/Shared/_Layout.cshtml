<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigitalBanking</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    @{
        var loggedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.Token));
        var isAdmin = string.Equals(Context.Session.GetString(SessionKeys.Role), "Admin", StringComparison.OrdinalIgnoreCase);
        var username = Context.Session.GetString(SessionKeys.Username) ?? "";
        var role = Context.Session.GetString(SessionKeys.Role) ?? "";
    }
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">DigitalBanking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (loggedIn)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/">Panel</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Reports/TopAccounts">Hesap sıralaması</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" href="/Admin/Users">Kullanıcılar</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="navbar-text me-2">@username <span class="badge bg-secondary">@role</span></span>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="/Logout">Çıkış</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
