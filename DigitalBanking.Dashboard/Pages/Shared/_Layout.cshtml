@inject IWebHostEnvironment Environment
@using DigitalBanking.Dashboard.Services
@{
    var loggedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.Token));
    var roleValue = Context.Session.GetString(SessionKeys.Role) ?? "";
    var isAdmin = string.Equals(roleValue, "Owner", StringComparison.OrdinalIgnoreCase);
    var isDelegated = string.Equals(roleValue, "DelegatedApprover", StringComparison.OrdinalIgnoreCase);
    var username = Context.Session.GetString(SessionKeys.Username) ?? "";
    var displayName = Context.Session.GetString(SessionKeys.DisplayName) ?? username;
    var role = Context.Session.GetString(SessionKeys.Role) ?? "";
    var roleLabel = isAdmin ? "Kurucu Yönetici" : isDelegated ? "Yetkili" : "Müşteri";
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var title = ViewData["Title"]?.ToString() ?? "DigitalBanking";
    var isCustomer = !isAdmin && !isDelegated;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1e33" />
    <title>@title · DigitalBanking</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="@(loggedIn ? "app-body" : "auth-body")">
<a class="skip-link" href="#main-content">İçeriğe atla</a>

<svg class="icon-sprite" aria-hidden="true" focusable="false">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
    <symbol id="i-inbox" viewBox="0 0 24 24"><path d="M4 4h16l2 9v5a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5l2-9Z"/><path d="M2 14h5l2 3h6l2-3h5"/></symbol>
    <symbol id="i-activity" viewBox="0 0 24 24"><path d="M3 12h4l2-7 4 14 2-7h6"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3 3 0 0 1 0 6"/><path d="M18 14a5 5 0 0 1 3 6"/></symbol>
    <symbol id="i-wallet" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><path d="M16 14h2"/><path d="M17 4H6a3 3 0 0 0-3 3"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 4h6a3 3 0 0 1 3 3v14a3 3 0 0 0-3-3H4V4Z"/><path d="M20 4h-4a3 3 0 0 0-3 3v14a3 3 0 0 1 3-3h4V4Z"/></symbol>
    <symbol id="i-scale" viewBox="0 0 24 24"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M7 7l-3 6h6L7 7Z"/><path d="M17 7l-3 6h6l-3-6Z"/><path d="M8 21h8"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9"/><path d="m17 6 3 3"/><path d="m14 9 2 2"/></symbol>
    <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M12 3l1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></symbol>
    <symbol id="i-cards" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 10h18"/><path d="M7 15h4"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="m4 12 16-8-4 16-4-7-8-1Z"/><path d="m12 13 8-9"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8"/><path d="M8 12h8"/></symbol>
    <symbol id="i-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6"/><path d="M9 12h6"/></symbol>
    <symbol id="i-arrow-up" viewBox="0 0 24 24"><path d="M12 19V5"/><path d="m6 11 6-6 6 6"/></symbol>
    <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="m6 13 6 6 6-6"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12"/><path d="m18 6-12 12"/></symbol>
</svg>

@if (!loggedIn)
{
    <main class="auth-shell" id="main-content">
        @RenderBody()
    </main>
}
else
{
    <div class="app-shell" id="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-top">
                <a class="app-brand" href="/" aria-label="DigitalBanking ana sayfa">
                    <span class="brand-mark" aria-hidden="true">DB</span>
                    <span class="brand-copy">
                        <strong>DigitalBanking</strong>
                        <small>@(isAdmin ? "Kurucu yönetici konsolu" : isDelegated ? "Onay ve operasyon" : "Dijital bankacılık")</small>
                    </span>
                </a>
                <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="app-nav" aria-label="Menüyü aç">
                    <svg class="icon nav-toggle-open" aria-hidden="true"><use href="#i-menu"></use></svg>
                    <svg class="icon nav-toggle-close" aria-hidden="true"><use href="#i-close"></use></svg>
                </button>
            </div>

            <nav class="app-nav" id="app-nav" aria-label="Ana menü">
                @if (isAdmin)
                {
                    <div class="nav-section">Kontrol</div>
                    <a class="nav-link @(page.Contains("/Admin/Overview") ? "active" : "")" href="/Admin/Overview" aria-current="@(page.Contains("/Admin/Overview") ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-grid"></use></svg><span>Genel Bakış</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Approvals") ? "active" : "")" href="/Admin/Approvals" aria-current="@(page.Contains("/Admin/Approvals") ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-inbox"></use></svg><span>Onay Kuyruğu</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Operations") ? "active" : "")" href="/Admin/Operations" aria-current="@(page.Contains("/Admin/Operations") ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-activity"></use></svg><span>Operasyon Merkezi</span></a>

                    <div class="nav-section">Müşteri ve portföy</div>
                    <a class="nav-link @(page.Contains("/Admin/Customers") ? "active" : "")" href="/Admin/Customers"><svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg><span>Müşteriler</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Accounts") ? "active" : "")" href="/Admin/Accounts"><svg class="icon" aria-hidden="true"><use href="#i-wallet"></use></svg><span>Hesaplar</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Accounting") ? "active" : "")" href="/Admin/Accounting"><svg class="icon" aria-hidden="true"><use href="#i-book"></use></svg><span>Muhasebe</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Reconciliation") ? "active" : "")" href="/Admin/Reconciliation"><svg class="icon" aria-hidden="true"><use href="#i-scale"></use></svg><span>Mutabakat</span></a>
                    <a class="nav-link @(page.Contains("/Reports/TopAccounts") ? "active" : "")" href="/Reports/TopAccounts"><svg class="icon" aria-hidden="true"><use href="#i-chart"></use></svg><span>Raporlar</span></a>

                    <div class="nav-section">Yönetişim</div>
                    <a class="nav-link @(page.Contains("/Admin/Users") ? "active" : "")" href="/Admin/Users"><svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg><span>Üyeler</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Delegations") ? "active" : "")" href="/Admin/Delegations"><svg class="icon" aria-hidden="true"><use href="#i-key"></use></svg><span>Yetkiler & Limitler</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Audit") ? "active" : "")" href="/Admin/Audit"><svg class="icon" aria-hidden="true"><use href="#i-shield"></use></svg><span>Denetim</span></a>

                    @if (Environment.IsDevelopment())
                    {
                        <div class="nav-section">Demo</div>
                        <a class="nav-link @(page.Contains("/Admin/Demo") ? "active" : "")" href="/Admin/Demo"><svg class="icon" aria-hidden="true"><use href="#i-sparkle"></use></svg><span>Senaryo Merkezi</span></a>
                    }
                }
                else if (isDelegated)
                {
                    <div class="nav-section">Onay ve operasyon</div>
                    <a class="nav-link @(page.Contains("/Admin/Approvals") ? "active" : "")" href="/Admin/Approvals"><svg class="icon" aria-hidden="true"><use href="#i-inbox"></use></svg><span>Onay Kuyruğu</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Operations") ? "active" : "")" href="/Admin/Operations"><svg class="icon" aria-hidden="true"><use href="#i-activity"></use></svg><span>Operasyon Merkezi</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Accounting") ? "active" : "")" href="/Admin/Accounting"><svg class="icon" aria-hidden="true"><use href="#i-book"></use></svg><span>Muhasebe</span></a>
                    <a class="nav-link @(page.Contains("/Admin/Reconciliation/Exceptions") ? "active" : "")" href="/Admin/Reconciliation/Exceptions"><svg class="icon" aria-hidden="true"><use href="#i-scale"></use></svg><span>Mutabakat İstisnaları</span></a>
                }
                else
                {
                    <div class="nav-section">Bankacılık</div>
                    <a class="nav-link @(page.Contains("/Customer/Home") ? "active" : "")" href="/Customer/Home" aria-current="@(page.Contains("/Customer/Home") ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-home"></use></svg><span>Hesap Özeti</span></a>
                    <a class="nav-link @(page.Contains("/Customer/Accounts") ? "active" : "")" href="/Customer/Accounts"><svg class="icon" aria-hidden="true"><use href="#i-cards"></use></svg><span>Hesaplarım</span></a>
                    <div class="nav-section">İşlemler</div>
                    <a class="nav-link @(page.Contains("/Customer/Transfer") ? "active" : "")" href="/Customer/Transfer"><svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg><span>Transfer</span></a>
                    <a class="nav-link @(page.Contains("/Customer/Requests") ? "active" : "")" href="/Customer/Requests"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg><span>Finansal Talepler</span></a>
                    <a class="nav-link @(page.Contains("/Customer/Payments") ? "active" : "")" href="/Customer/Payments"><svg class="icon" aria-hidden="true"><use href="#i-receipt"></use></svg><span>Ödemelerim</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-chip">
                    <span class="avatar" aria-hidden="true">@((displayName.Length > 0 ? displayName[0] : '?').ToString().ToUpperInvariant())</span>
                    <span class="user-copy">
                        <strong>@displayName</strong>
                        <small>@roleLabel</small>
                    </span>
                </div>
                <a class="btn btn-sm btn-outline-light w-100 logout-button" href="/Logout">Çıkış yap</a>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-heading">
                    <div class="eyebrow">@(isAdmin ? "Kurucu Yönetici konsolu" : isDelegated ? "Yetkili onay konsolu" : "Dijital bankacılık")</div>
                    <h1>@title</h1>
                </div>
                <div class="topbar-meta">
                    <span class="role-badge @(isAdmin ? "role-owner" : isDelegated ? "role-approver" : "role-customer")">@roleLabel</span>
                    <span class="topbar-date">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </header>

            <main class="app-content" id="main-content">
                @RenderBody()
            </main>
        </div>
    </div>
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
