@inject IWebHostEnvironment Environment
@using DigitalBanking.Dashboard.Services
@{
    var loggedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.Token));
    var roleValue = Context.Session.GetString(SessionKeys.Role) ?? "";
    var isAdmin = string.Equals(roleValue, "Owner", StringComparison.OrdinalIgnoreCase);
    var isDelegated = string.Equals(roleValue, "DelegatedApprover", StringComparison.OrdinalIgnoreCase);
    var username = Context.Session.GetString(SessionKeys.Username) ?? "";
    var displayName = Context.Session.GetString(SessionKeys.DisplayName) ?? username;
    var role = Context.Session.GetString(SessionKeys.Role) ?? "";
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var title = ViewData["Title"]?.ToString() ?? "DigitalBanking";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · DigitalBanking</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<a class="skip-link" href="#main-content">İçeriğe atla</a>
@if (!loggedIn)
{
    <main class="auth-shell" id="main-content">
        @RenderBody()
    </main>
}
else
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="app-brand" href="/">
                <span class="brand-mark">DB</span>
                <span>
                    <strong>DigitalBanking</strong>
                    <small>Operasyon demo</small>
                </span>
            </a>

            <nav class="app-nav">
                @if (isAdmin)
                {
                    <div class="nav-section">Yönetim</div>
                    <a class="nav-link @(page.Contains("/Admin/Overview") ? "active" : "")" href="/Admin/Overview">Genel Bakış</a>
                    <a class="nav-link @(page.Contains("/Admin/Customers") ? "active" : "")" href="/Admin/Customers">Müşteriler</a>
                    <a class="nav-link @(page.Contains("/Admin/Accounts") ? "active" : "")" href="/Admin/Accounts">Hesaplar</a>
                    <a class="nav-link @(page.Contains("/Admin/Approvals") ? "active" : "")" href="/Admin/Approvals">Onay Kuyruğu</a>
                    <a class="nav-link @(page.Contains("/Admin/Operations") ? "active" : "")" href="/Admin/Operations">Operasyon Merkezi</a>
                    <a class="nav-link @(page.Contains("/Admin/Accounting") ? "active" : "")" href="/Admin/Accounting">Muhasebe</a>
                    <a class="nav-link @(page.Contains("/Admin/Reconciliation") ? "active" : "")" href="/Admin/Reconciliation">Mutabakat</a>
                    <a class="nav-link @(page.Contains("/Reports/TopAccounts") ? "active" : "")" href="/Reports/TopAccounts">Raporlar</a>
                    <a class="nav-link @(page.Contains("/Admin/Audit") ? "active" : "")" href="/Admin/Audit">Denetim</a>
                    <a class="nav-link @(page.Contains("/Admin/Users") ? "active" : "")" href="/Admin/Users">Üyeler</a>
                    <a class="nav-link @(page.Contains("/Admin/Delegations") ? "active" : "")" href="/Admin/Delegations">Yetkiler & Limitler</a>
                    @if (Environment.IsDevelopment())
                    {
                        <div class="nav-section">Demo</div>
                        <a class="nav-link @(page.Contains("/Admin/Demo") ? "active" : "")" href="/Admin/Demo">Senaryo Merkezi</a>
                    }
                }
                else if (isDelegated)
                {
                    <div class="nav-section">Onay</div>
                    <a class="nav-link @(page.Contains("/Admin/Approvals") ? "active" : "")" href="/Admin/Approvals">Onay Kuyruğu</a>
                    <a class="nav-link @(page.Contains("/Admin/Operations") ? "active" : "")" href="/Admin/Operations">Operasyon Merkezi</a>
                    <a class="nav-link @(page.Contains("/Admin/Accounting") ? "active" : "")" href="/Admin/Accounting">Muhasebe</a>
                    <a class="nav-link @(page.Contains("/Admin/Reconciliation/Exceptions") ? "active" : "")" href="/Admin/Reconciliation/Exceptions">Mutabakat İstisnaları</a>
                }
                else
                {
                    <div class="nav-section">Bankacılık</div>
                    <a class="nav-link @(page.Contains("/Customer/Home") ? "active" : "")" href="/Customer/Home">Hesap Özeti</a>
                    <a class="nav-link @(page.Contains("/Customer/Accounts") ? "active" : "")" href="/Customer/Accounts">Hesaplarım</a>
                    <a class="nav-link @(page.Contains("/Customer/Transfer") ? "active" : "")" href="/Customer/Transfer">Transfer</a>
                    <a class="nav-link @(page.Contains("/Customer/Requests") ? "active" : "")" href="/Customer/Requests">Finansal Talepler</a>
                    <a class="nav-link @(page.Contains("/Customer/Payments") ? "active" : "")" href="/Customer/Payments">Ödemelerim</a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-chip">
                    <span class="avatar">@((displayName.Length > 0 ? displayName[0] : '?').ToString().ToUpperInvariant())</span>
                    <span>
                        <strong>@displayName</strong>
                        <small>@DashboardUi.Status(role)</small>
                    </span>
                </div>
                <a class="btn btn-sm btn-outline-light w-100" href="/Logout">Çıkış</a>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div>
                    <div class="eyebrow">@(isAdmin ? "Owner konsolu" : isDelegated ? "Yetkili onay konsolu" : "Dijital bankacılık")</div>
                    <h1>@title</h1>
                </div>
                <div class="topbar-meta">
                    <span class="pill">@(isAdmin ? "Owner" : isDelegated ? "Yetkili" : "Müşteri")</span>
                    <span class="text-muted small">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </header>

            <main class="app-content" id="main-content">
                @RenderBody()
            </main>
        </div>
    </div>
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
