@page
@model DigitalBanking.Dashboard.Pages.Reports.TopAccountsModel
@{
    ViewData["Title"] = "Hesap Sıralaması";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="mb-0">Hesap Sıralaması</h3>
    <form method="get" class="d-flex flex-wrap gap-2">
        <input class="form-control" type="date" name="from" value="@Model.From" aria-label="Başlangıç" />
        <input class="form-control" type="date" name="to" value="@Model.To" aria-label="Bitiş" />
        <select class="form-select" name="currency" style="width:110px;" aria-label="Para birimi">
            @foreach (var code in new[] { "TRY", "USD", "EUR", "GBP" })
            {
                <option value="@code" selected="@(Model.Currency == code)">@code</option>
            }
        </select>
        <input class="form-control" type="number" name="limit" value="@Model.Limit" min="1" max="50" style="width:100px;" aria-label="Adet" />
        <button class="btn btn-outline-primary" type="submit">Uygula</button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Hesap</th>
                        <th>Para birimi</th>
                        <th class="text-end">İşlem</th>
                        <th class="text-end">Yatırma</th>
                        <th class="text-end">Çekme</th>
                        <th class="text-end">Transfer giriş</th>
                        <th class="text-end">Transfer çıkış</th>
                        <th class="text-end">Net akış</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model.Items)
                    {
                        <tr>
                            <td style="font-family:monospace;">@x.AccountNumber</td>
                            <td>@x.Currency</td>
                            <td class="text-end">@x.TransactionCount</td>
                            <td class="text-end">@x.DepositTotal.ToString("N2")</td>
                            <td class="text-end">@x.WithdrawTotal.ToString("N2")</td>
                            <td class="text-end">@x.TransferInTotal.ToString("N2")</td>
                            <td class="text-end">@x.TransferOutTotal.ToString("N2")</td>
                            <td class="text-end">@x.NetFlow.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-secondary">Seçilen aralıkta veri yok.</div>
}
