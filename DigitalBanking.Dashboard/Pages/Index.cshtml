@page
@model DigitalBanking.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Panel";
}

@if (Model.AccessDenied)
{
    <div class="alert alert-warning">Bu ekran için Admin yetkisi gerekir.</div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>DigitalBanking demo paneli</h4>
                <p class="text-muted mb-2">
                    Hoş geldiniz <strong>@Model.CurrentUsername</strong>
                    <span class="badge bg-secondary">@Model.CurrentRole</span>
                </p>
                @if (Model.CurrentRole == "Admin")
                {
                    <p class="text-muted mb-0">
                        Admin raporu ve kullanıcı yönetimi hazır. Müşteri, hesap, işlem,
                        onay kuyruğu ve audit ekranları bir sonraki dashboard aşamasında eklenecek.
                    </p>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Müşteri self-servis ekranları (kendi hesapları, bakiye kartları,
                        transfer talebi) User–Customer sahipliği eklendikten sonra açılacak.
                        Şu an standart kullanıcı yalnız oturum bilgisini görür.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
