@page
@model DigitalBanking.Dashboard.Pages.Admin.Approvals.IndexModel
@using DigitalBanking.Dashboard.Services
@{
    ViewData["Title"] = "Onay Kuyruğu";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h3 class="mb-1">Onay Kuyruğu</h3>
        <div class="text-muted small">
            @(Model.CurrentRole == "Owner"
                ? "Kurucu yönetici tüm talepleri görür. Kendi oluşturduğunuz talepleri onaylayamazsınız."
                : "Yalnız yetkinizdeki operasyon, para birimi ve tutarlar gösterilir; kendi talebiniz görünmez.")
        </div>
    </div>
    <form method="get" class="d-flex flex-wrap gap-2">
        <select class="form-select" name="status" aria-label="Talep durumu" style="width:150px;">
            @foreach (var s in new[] { "Pending", "Approved", "Rejected", "Cancelled" })
            {
                <option value="@s" selected="@(Model.Status == s)">@DashboardUi.Status(s)</option>
            }
        </select>
        <select class="form-select" name="requestType" aria-label="Talep türü" style="width:170px;">
            <option value="">Tüm türler</option>
            @foreach (var t in new[] { "Transfer", "Deposit", "Withdrawal", "AccountOpening" })
            {
                <option value="@t" selected="@(Model.RequestType == t)">@DashboardUi.Status(t)</option>
            }
        </select>
        <select class="form-select" name="currency" aria-label="Para birimi" style="width:110px;">
            <option value="">Para birimi</option>
            @foreach (var c in new[] { "TRY", "USD", "EUR", "GBP" })
            {
                <option value="@c" selected="@(Model.Currency == c)">@c</option>
            }
        </select>
        <button class="btn btn-outline-primary" type="submit">Filtrele</button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Items.Count == 0)
{
    <div class="card"><div class="empty-state">Bu filtrede talep yok.</div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr><th>Referans</th><th>Tür</th><th class="text-end">Tutar</th><th>Risk</th><th>Durum</th><th>Talep eden</th><th>Tarih</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><a href="/Admin/Approvals/Details?id=@p.Id">@p.Reference</a></td>
                        <td>@DashboardUi.Status(p.RequestType)</td>
                        <td class="text-end">@DashboardUi.Money(p.Amount, p.Currency)</td>
                        <td><span class="@DashboardUi.RiskBadgeClass(p.RiskLevel)">@DashboardUi.Status(p.RiskLevel)</span></td>
                        <td><span class="@DashboardUi.StatusBadgeClass(p.Status)">@DashboardUi.Status(p.Status)</span></td>
                        <td class="small">@(p.RequestedByUserId == Model.CurrentUserId ? "Siz" : p.RequestedByUserId.ToString("N")[..8])</td>
                        <td>@DashboardUi.Date(p.CreatedAt)</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Admin/Approvals/Details?id=@p.Id">Aç</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
